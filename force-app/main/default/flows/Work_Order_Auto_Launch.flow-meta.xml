                    <stringValue>Deposit Required</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_WorkOrder.Deposit_Payments__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Waiting for deposit</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Deposit_Payment_Screen</targetReference>
            </connector>
            <label>Validate</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validation_on_Parts_Hardware</name>
