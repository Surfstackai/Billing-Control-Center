                    <stringValue>Parts Required</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_WorkOrder.Parts_Hardware__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Parts Ordered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Parts_Screen</targetReference>
            </connector>
            <label>Validate Parts</label>
        </rules>
    </decisions>
