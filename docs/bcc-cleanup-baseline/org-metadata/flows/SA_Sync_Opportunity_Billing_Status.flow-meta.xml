        <label>Update Opportunity To Ready For Billing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Billing_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Ready for Billing</stringValue>
            </value>
        </filters>
        <filters>
            <field>Ready_for_Billing_Date__c</field>
