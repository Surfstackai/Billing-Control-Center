<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Set_Has_Eligible_Opportunity_True</name>
        <label>Set Has Eligible Opportunity True</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varHasEligibleOpportunity</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_WorkOrder_Opportunities</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Already_Has_Eligible_Opportunity</name>
        <label>Already Has Eligible Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Eligible_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Check Current Opportunity</defaultConnectorLabel>
        <rules>
            <name>Has_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHasEligibleOpportunity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_WorkOrder_Opportunities</targetReference>
            </connector>
            <label>Has Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Eligible_Opportunity</name>
        <label>Check Eligible Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_WorkOrder_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Eligible</defaultConnectorLabel>
        <rules>
            <name>Eligible_Opportunity_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Eligible_Opportunity.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Has_Eligible_Opportunity_True</targetReference>
            </connector>
            <label>Eligible Opportunity Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Evaluate_Eligible_Opportunity</name>
        <label>Evaluate Eligible Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Allow Save Without Eligible Opportunity</defaultConnectorLabel>
        <rules>
            <name>Has_Eligible_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varHasEligibleOpportunity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Has Eligible Opportunity</label>
        </rules>
    </decisions>
    <description>Do not block Work Order saves when Opportunity billing status is missing. Completing an assigned Service Appointment must not depend on Opportunity linkage. Keep this flow inactive.</description>
    <environments>Default</environments>
    <interviewLabel>Work Order Validate Billing Opportunity For Scheduling {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Work Order Validate Billing Opportunity For Scheduling</label>
    <loops>
        <name>Loop_WorkOrder_Opportunities</name>
        <label>Loop WorkOrder Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_WorkOrder_Opportunities</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Already_Has_Eligible_Opportunity</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Evaluate_Eligible_Opportunity</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Eligible_Opportunity</name>
        <label>Get Eligible Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Eligible_Opportunity</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4)</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_WorkOrder_Opportunities.Opportunity__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Billing_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Not Ready</stringValue>
            </value>
        </filters>
        <filters>
            <field>Billing_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Ready for Billing</stringValue>
            </value>
        </filters>
        <filters>
            <field>Billing_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Awaiting Billing</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_WorkOrder_Opportunities</name>
        <label>Get WorkOrder Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_WorkOrder_Opportunities</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Work_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Opportunity_WorkOrder__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_WorkOrder_Opportunities</targetReference>
        </connector>
        <filterLogic>(1 OR 2 OR 3) AND (4 OR 5)</filterLogic>
        <filters>
            <field>Parts_Hardware__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>All Parts Received</stringValue>
            </value>
        </filters>
        <filters>
            <field>Parts_Hardware__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>All Parts at WS</stringValue>
            </value>
        </filters>
        <filters>
            <field>Parts_Hardware__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>All Parts at WH</stringValue>
            </value>
        </filters>
        <filters>
            <field>Deposit_Payments__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Deposit received</stringValue>
            </value>
        </filters>
        <filters>
            <field>Deposit_Payments__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>No Deposit required</stringValue>
            </value>
        </filters>
        <object>WorkOrder</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>varHasEligibleOpportunity</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
